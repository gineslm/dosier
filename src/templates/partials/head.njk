<!DOCTYPE html>
<html lang="{{ lang }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page.meta.title }}</title>
    <meta name="description" content="{{ page.meta.description }}">
{% if page.meta.og %}
    <meta property="og:title" content="{{ page.meta.og.title }}">
    <meta property="og:description" content="{{ page.meta.og.description }}">
    <meta property="og:type" content="website">
{% endif %}
    <meta name="theme-color" content="{{ page.meta.themeColor }}">

    <link rel="canonical" href="{{ page.meta.canonical }}">
    <link rel="alternate" hreflang="en" href="{{ page.meta.hreflangEn }}">
    <link rel="alternate" hreflang="es" href="{{ page.meta.hreflangEs }}">
    <link rel="alternate" hreflang="x-default" href="{{ page.meta.hreflangDefault }}">
{% if page.meta.atsPdf %}
    <link rel="alternate" type="application/pdf" hreflang="{{ lang }}" href="{{ assetsPath }}assets/docs/{{ page.meta.atsPdf.file }}" title="{{ page.meta.atsPdf.title }}">
{% endif %}

    <link rel="preload" href="{{ assetsPath }}fonts/roboto-variable.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ assetsPath }}fonts/roboto-condensed-variable.woff2" as="font" type="font/woff2" crossorigin>

    <link rel="stylesheet" href="{{ assetsPath }}tokens.css">
    <link rel="stylesheet" href="{{ stylesheetHref }}">
{% if page.meta.jsonLd %}

    <script type="application/ld+json">
    {{ page.meta.jsonLd | json | safe }}
    </script>
{% endif %}
</head>

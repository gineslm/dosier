{% extends "layouts/case-study.njk" %}
{% block body %}
      <div id="{{ page.body.hero.id }}" data-sec="{{ page.body.hero.id }}" style="padding: 8px 0 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <div style="font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 10px;">{{ page.body.hero.kicker }}</div>
        <h1 data-r="h1-lead" style="font-weight: var(--weight-thin); font-size: var(--text-name); line-height: var(--text-name-lh); margin: 0 0 14px; color: var(--color-ink); max-width: 20ch; text-wrap: pretty;">{{ page.body.hero.title }}</h1>
        <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0 0 10px; max-width: 70ch;">{{ page.body.hero.sub }}</p>
        <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 20px; font-weight: 300; max-width: 75ch;">{{ page.body.hero.lead }}</p>
        <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 24px;">
          <a href="{{ page.body.hero.ctaPrimaryHref }}" target="_blank" rel="noopener noreferrer" style="border: 1px solid var(--color-accent); color: var(--color-accent-strong); padding: 9px 14px; border-radius: 999px; text-decoration: none; font-size: var(--text-ui);">{{ page.body.hero.ctaPrimary }} <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">{{ page.body.links.newWindow }}</span></a>
          <a href="#{{ page.body.start.id }}" style="border: 1px solid var(--color-chip-border); color: var(--color-body); padding: 9px 14px; border-radius: 999px; text-decoration: none; font-size: var(--text-ui);">{{ page.body.hero.ctaSecondary }}</a>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule);">
{% for fact in page.body.hero.facts %}
          <div style="background: var(--color-surface); padding: 14px 16px;">
            <div style="font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 4px;">{{ fact.k }}</div>
            <div style="font-size: var(--text-ui); line-height: 1.5; color: var(--color-ink);">{{ fact.v }}</div>
          </div>
{% endfor %}
        </div>
      </div>

      <div id="{{ page.body.deliverables.id }}" data-sec="{{ page.body.deliverables.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.deliverables.heading }}</h2>
        <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 20px; font-weight: 300; max-width: 75ch;">{{ page.body.deliverables.intro }}</p>
        <div data-r="grid2" style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: start;">
{% for card in page.body.deliverables.cards %}
          <div style="border: 1px solid var(--color-chip-border); border-top: 4px solid var(--color-accent); background: var(--color-surface); padding: 20px;">
            <p style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent-strong); margin: 0 0 8px; text-transform: uppercase;">{{ card.label }}</p>
            <h3 style="font-size: 20px; font-weight: var(--weight-thin); margin: 0 0 10px; color: var(--color-ink);">{{ card.title }}</h3>
            <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0 0 12px;">{{ card.text }}</p>
            <ul style="margin: 0; padding-left: 18px; font-size: var(--text-ui); line-height: 1.6; color: var(--color-body);">
{% for point in card.points %}
              <li>{{ point }}</li>
{% endfor %}
            </ul>
          </div>
{% endfor %}
        </div>
      </div>

      <div id="{{ page.body.start.id }}" data-sec="{{ page.body.start.id }}" style="max-width: 619px; padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.start.heading }}</h2>
        <div style="border: 1px solid var(--color-chip-border); border-left: 4px solid var(--color-accent); background: var(--color-accent-soft); padding: 20px; margin-bottom: 14px;">
          <p style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent-strong); margin: 0 0 8px; text-transform: uppercase;">{{ page.body.start.kicker }}</p>
          <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-ink); margin: 0; font-weight: 300;">{{ page.body.start.callout }}</p>
        </div>
{% for p in page.body.start.paragraphs %}
        <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 14px; font-weight: 300; max-width: 75ch; text-wrap: pretty;">{{ p }}</p>
{% endfor %}
        <a href="{{ page.body.start.linkHref }}" style="font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; color: var(--color-accent-strong); text-transform: uppercase; letter-spacing: 0.04em;">{{ page.body.start.linkLabel }}</a>
      </div>

      <div id="{{ page.body.method.id }}" data-sec="{{ page.body.method.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.method.heading }}</h2>
        <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 20px; font-weight: 300; max-width: 75ch;">{{ page.body.method.intro }}</p>
        <ol style="margin: 0; padding: 0; list-style: none; display: grid; gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule); max-width: 75ch;">
{% for step in page.body.method.steps %}
          <li style="background: var(--color-surface); padding: 14px 16px; display: flex; gap: 14px;">
            <span style="font-family: var(--font-condensed); font-weight: 700; color: var(--color-accent-strong);">{{ loop.index }}</span>
            <span style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body);"><strong style="color: var(--color-ink); font-weight: 500;">{{ step.term }}.</strong> {{ step.def }}</span>
          </li>
{% endfor %}
        </ol>
      </div>

      <div id="{{ page.body.state.id }}" data-sec="{{ page.body.state.id }}" style="max-width: 619px; padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.state.heading }}</h2>
{% for p in page.body.state.paragraphs %}
        <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 14px; font-weight: 300; max-width: 75ch; text-wrap: pretty;">{{ p }}</p>
{% endfor %}
        <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-muted); margin: 10px 0 0; max-width: 75ch;">{{ page.body.state.note }}</p>
      </div>

      <div id="{{ page.body.links.id }}" data-sec="{{ page.body.links.id }}" style="padding-bottom: 8px; scroll-margin-top: 90px;">
        <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.links.heading }}</h2>
        <div style="display: flex; flex-wrap: wrap; gap: 9px;">
{% for l in page.body.links.items %}
          <a href="{{ l.href }}" target="_blank" rel="noopener noreferrer" style="border: 1px solid var(--color-chip-border); color: var(--color-body); padding: 9px 14px; border-radius: 999px; text-decoration: none; font-size: var(--text-ui);">{{ l.label }} <span style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;">{{ page.body.links.newWindow }}</span></a>
{% endfor %}
        </div>
      </div>
{% endblock %}

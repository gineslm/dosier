              <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ d.label }}</div>
                <h3 style="margin: 0; color: var(--color-ink); font-size: 15px;">{{ d.title }}</h3>
                <div><div style="font-size: var(--text-ui); color: var(--color-muted); margin-bottom: 4px;">{{ page.body.ux.decisions.problemLabel }}</div><p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 60ch;">{{ d.problem }}</p></div>
                <div><div style="font-size: var(--text-ui); color: var(--color-accent-strong); margin-bottom: 4px;">{{ page.body.ux.decisions.choiceLabel }}</div><p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-ink); margin: 0; max-width: 60ch;">{{ d.choice }}</p></div>
                <div><div style="font-size: var(--text-ui); color: var(--color-muted); margin-bottom: 4px;">{{ page.body.ux.decisions.costLabel }}</div><p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 60ch;">{{ d.cost }}</p></div>
                <div style="border-left: 2px solid var(--color-accent); padding-left: 16px;"><div style="font-size: var(--text-ui); color: var(--color-accent-strong); margin-bottom: 4px;">{{ page.body.ux.decisions.checkLabel }}</div><p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 60ch;">{{ d.check }}</p></div>
              </div>
            </div>
          </div>
{% endfor %}

          <div style="padding-top: 8px;">
            <div data-r="grid2" style="display: grid; grid-template-columns: minmax(280px,464px) minmax(0,1fr); gap: 32px; align-items: start;">
              <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.ux.decisions.afterLabel }}</div>
                <img src="{{ assetsPath }}assets/img/casos/imoles/{{ page.body.ux.decisions.item4.afterImg }}" alt="{{ page.body.ux.decisions.item4.afterAlt }}" style="width: 180px; height: auto; border: 1px solid var(--color-rule); display: block;">
                <div style="font-size: var(--text-note); color: var(--color-muted); max-width: 180px;">{{ page.body.ux.decisions.item4.afterCaption }}</div>
              </div>
              <div style="display: flex; flex-direction: column; gap: 12px;">
                <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.ux.decisions.item4.label }}</div>
                <h3 style="margin: 0; color: var(--color-ink); font-size: 15px;">{{ page.body.ux.decisions.item4.title }}</h3>
                <div><div style="font-size: var(--text-ui); color: var(--color-muted); margin-bottom: 4px;">{{ page.body.ux.decisions.problemLabel }}</div><p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 60ch;">{{ page.body.ux.decisions.item4.problem }}</p></div>
                <div><div style="font-size: var(--text-ui); color: var(--color-accent-strong); margin-bottom: 4px;">{{ page.body.ux.decisions.choiceLabel }}</div><p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-ink); margin: 0; max-width: 60ch;">{{ page.body.ux.decisions.item4.choice }}</p></div>
                <div><div style="font-size: var(--text-ui); color: var(--color-muted); margin-bottom: 4px;">{{ page.body.ux.decisions.costLabel }}</div><p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 60ch;">{{ page.body.ux.decisions.item4.cost }}</p></div>
                <div style="border-left: 2px solid var(--color-accent); padding-left: 16px;"><div style="font-size: var(--text-ui); color: var(--color-accent-strong); margin-bottom: 4px;">{{ page.body.ux.decisions.checkLabel }}</div><p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 60ch;">{{ page.body.ux.decisions.item4.check }}</p></div>
              </div>
            </div>
          </div>
        </div>

        <div style="padding: 32px 0 0;">
          <div style="margin-bottom: 20px;">
            <h3 style="font-family: var(--font-condensed); font-weight: 700; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 10px; color: var(--color-ink);">{{ page.body.ux.behavior.heading }}</h3>
            <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 70ch;">{{ page.body.ux.behavior.lead }}</p>
          </div>
          <div style="border: 1px solid var(--color-rule); overflow-x: auto;">
            <div style="padding: 16px 18px; border-bottom: 1px solid var(--color-rule);">
              <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.ux.behavior.contractLabel }}</div>
              <div style="color: var(--color-ink); margin-top: 4px; font-size: 14px; font-weight: 600;">{{ page.body.ux.behavior.contractTitle }}</div>
            </div>
            <table style="width: 100%; min-width: 460px; border-collapse: collapse;">
              <tbody>
{% for row in page.body.ux.behavior.rows %}
                <tr style="{% if not loop.last %}border-bottom: 1px solid var(--color-rule);{% endif %}"><td style="font-size: var(--text-ui); padding: 12px 20px; color: var(--color-ink); vertical-align: top; white-space: nowrap;">{{ row.k }}</td><td style="font-size: var(--text-ui); padding: 12px 20px; color: var(--color-body);">{{ row.v }}</td></tr>
{% endfor %}
              </tbody>
            </table>
          </div>
        </div>

        <div style="padding: 32px 0 0;">
          <div data-r="grid2" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 32px;">
            <div>
              <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 12px; color: var(--color-ink);">{{ page.body.ux.accessibility.heading }}</h2>
              <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0;">{{ page.body.ux.accessibility.lead }}</p>
            </div>
            <div style="display: flex; flex-direction: column; gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule);">
{% for a in page.body.ux.accessibility.items %}
              <div style="background: var(--color-surface); padding: 18px 20px;{% if loop.last %} border-left: 3px solid var(--color-accent);{% endif %}">
                <div style="font-size: var(--text-ui); color: {% if loop.last %}var(--color-accent-strong){% else %}var(--color-ink){% endif %};">{{ a.t }}</div>
                <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 5px 0 0;">{{ a.d }}</p>
              </div>
{% endfor %}
            </div>
          </div>
        </div>

        <div id="{{ page.body.ux.prototype.id }}" style="padding: 32px 0 0;">
          <div style="margin-bottom: 20px;">
            <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 15px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 12px; color: var(--color-ink);">{{ page.body.ux.prototype.heading }}</h2>
            <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300; max-width: 70ch;">{{ page.body.ux.prototype.lead }}</p>
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px;">
{% for tag in page.body.ux.prototype.tags %}
            <span style="border: 1px solid var(--color-chip-border); padding: 6px 11px; color: var(--color-body); font-size: var(--text-note);">{{ tag }}</span>
{% endfor %}
          </div>
          <div style="border: 1px solid var(--color-rule-strong); background: var(--color-surface); padding: 28px; text-align: center;">
            <a href="{{ page.body.ux.prototype.prototypeUrl }}" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--color-accent); color: var(--color-accent-strong); padding: 11px 18px; border-radius: 999px; text-decoration: none; font-family: var(--font-condensed); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: var(--text-legal);">{{ page.body.ux.prototype.prototypeLinkLabel }}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6"></path></svg>
              <span class="visually-hidden">{{ page.body.ux.prototype.opensInNewWindow }}</span>
            </a>
          </div>
          <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 12px 0 0; max-width: 74ch;">{{ page.body.ux.prototype.note }}</p>
          <div style="margin-top: 24px; border: 1px solid var(--color-rule);">
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong); padding: 14px 18px; border-bottom: 1px solid var(--color-rule);">{{ page.body.ux.prototype.techLabel }}</div>
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1px; background: var(--color-rule);">
{% for t in page.body.ux.prototype.tech %}
              <div style="background: var(--color-surface); padding: 14px 18px; display: flex; flex-direction: column; gap: 5px;">
                <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted);">{{ t.k }}</div>
                <div style="font-size: var(--text-note); color: var(--color-ink);">{{ t.v }}</div>
              </div>
{% endfor %}
            </div>
          </div>
        </div>
      </div>

      <div id="{{ page.body.assumptions.id }}" data-sec="{{ page.body.assumptions.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <div data-r="grid2" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 32px;">
          <div>
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-strong); margin-bottom: 10px;">{{ page.body.assumptions.num }} · {{ page.chrome.toc[6].label }}</div>
            <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 12px; color: var(--color-accent);">{{ page.body.assumptions.heading }}</h2>
            <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0;">{{ page.body.assumptions.lead }}</p>
          </div>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule);">
{% for a in page.body.assumptions.items %}
            <div style="background: var(--color-surface); padding: 20px; display: flex; flex-direction: column; gap: 8px;">
              <div style="font-size: var(--text-ui); color: var(--color-ink);">{{ a.t }}</div>
              <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 0;">{{ a.d }}</p>
            </div>
{% endfor %}
          </div>
        </div>
      </div>

      <div id="{{ page.body.closing.id }}" data-sec="{{ page.body.closing.id }}" style="max-width: 900px; scroll-margin-top: 90px;">
        <div data-r="grid2" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 32px;">
          <div>
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-strong); margin-bottom: 10px;">{{ page.body.closing.num }} · {{ page.chrome.toc[7].label }}</div>
            <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0; color: var(--color-accent);">{{ page.body.closing.heading }}</h2>
          </div>
          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div>
              <div style="font-size: var(--text-ui); color: var(--color-muted); margin-bottom: 8px;">{{ page.body.closing.nextLabel }}</div>
              <ul style="margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 8px;">
{% for n in page.body.closing.next %}
                <li style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); max-width: 66ch;">{{ n }}</li>
{% endfor %}
              </ul>
            </div>
            <div>
              <div style="font-size: var(--text-ui); color: var(--color-muted); margin-bottom: 8px;">{{ page.body.closing.producedLabel }}</div>
              <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 70ch;">{{ page.body.closing.produced }}</p>
            </div>
            <div style="border: 1px solid var(--color-accent); padding: 22px;">
              <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong); margin-bottom: 9px;">{{ page.body.closing.takeawayLabel }}</div>
              <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-ink); margin: 0; max-width: 70ch;">{{ page.body.closing.takeaway }}</p>

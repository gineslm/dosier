{% extends "layouts/case-study.njk" %}
{% block body %}
      <div id="cover" data-sec="cover" style="padding: 8px 0 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <div style="font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 10px;">{{ page.body.hero.kicker }}</div>
        <h1 data-r="h1-lead" style="font-weight: var(--weight-thin); font-size: var(--text-name); line-height: var(--text-name-lh); margin: 0 0 14px; color: var(--color-ink); max-width: 20ch; text-wrap: pretty;">{{ page.body.hero.title }}</h1>
        <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0 0 10px; max-width: 70ch;">{{ page.body.hero.sub }}</p>
        <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 20px; font-weight: 300; max-width: 75ch;">{{ page.body.hero.lead }}</p>
        <div style="display: flex; flex-wrap: wrap; gap: 9px; margin-bottom: 24px;">
          <a href="#{{ page.body.ux.prototype.id }}" style="border: 1px solid var(--color-accent); color: var(--color-accent-strong); padding: 9px 14px; border-radius: 999px; text-decoration: none; font-size: var(--text-ui);">{{ page.body.hero.ctaPrimary }}</a>
          <a href="#{{ page.body.ux.decisions.id }}" style="border: 1px solid var(--color-chip-border); color: var(--color-body); padding: 9px 14px; border-radius: 999px; text-decoration: none; font-size: var(--text-ui);">{{ page.body.hero.ctaSecondary }}</a>
        </div>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule);">
{% for fact in page.body.hero.facts %}
          <div style="background: var(--color-surface); padding: 17px 16px; display: flex; flex-direction: column; gap: 6px;">
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted);">{{ fact.k }}</div>
            <div style="font-size: var(--text-ui); color: var(--color-ink);">{{ fact.v }}</div>
          </div>
{% endfor %}
        </div>
      </div>

      <div id="{{ page.body.starting.id }}" data-sec="{{ page.body.starting.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-strong); margin-bottom: 10px;">{{ page.body.starting.num }} · {{ page.chrome.toc[1].label }}</div>
        <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 12px; color: var(--color-accent);">{{ page.body.starting.heading }}</h2>
        <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 30px; font-weight: 300; max-width: 74ch; text-wrap: pretty;">{{ page.body.starting.lead }}</p>

        <div data-r="grid2" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 32px; margin-bottom: 36px; align-items: start;">
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted);">{{ page.body.starting.shotLabel }}</div>
            <img src="{{ assetsPath }}assets/img/casos/imoles/{{ page.body.starting.shotImage }}" alt="{{ page.body.starting.shotAlt }}" style="width: 100%; max-width: 212px; border: 1px solid var(--color-rule); display: block;">
          </div>
          <div style="display: flex; flex-direction: column; gap: 14px;">
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.starting.hadLabel }}</div>
            <div style="display: flex; flex-direction: column; gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule);">
{% for h in page.body.starting.had %}
              <div style="background: var(--color-surface); padding: 16px 18px; display: flex; flex-direction: column; gap: 6px;">
                <div style="font-size: var(--text-ui); color: var(--color-ink);">{{ h.t }}</div>
                <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 0;">{{ h.d }}</p>
              </div>
{% endfor %}
            </div>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 14px; margin-bottom: 26px;">
          <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted);">{{ page.body.starting.gapHeader }}</div>
          <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-ink); margin: 0; max-width: 76ch; font-weight: 300;">{{ page.body.starting.gapLead }}</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule);">
            <div style="background: var(--color-surface); padding: 22px; display: flex; flex-direction: column; gap: 12px;">
              <div style="font-size: var(--text-ui); color: var(--color-accent-strong);">{{ page.body.starting.gapProductLabel }}</div>
              <ul style="margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 9px;">
{% for item in page.body.starting.gapProduct %}
                <li style="font-size: var(--text-note); line-height: 1.5; color: var(--color-body); max-width: 46ch;">{{ item }}</li>
{% endfor %}
              </ul>
            </div>
            <div style="background: var(--color-surface); padding: 22px; display: flex; flex-direction: column; gap: 12px;">
              <div style="font-size: var(--text-ui); color: var(--color-accent-strong);">{{ page.body.starting.gapUxLabel }}</div>
              <ul style="margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 9px;">
{% for item in page.body.starting.gapUx %}
                <li style="font-size: var(--text-note); line-height: 1.5; color: var(--color-body); max-width: 46ch;">{{ item }}</li>
{% endfor %}
              </ul>
            </div>
          </div>
        </div>

        <div style="border-left: 2px solid var(--color-accent); padding-left: 16px;">
          <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-ink); margin: 0; max-width: 76ch; font-weight: 300;">{{ page.body.starting.closing }}</p>
        </div>
      </div>

      <div id="{{ page.body.benchmark.id }}" data-sec="{{ page.body.benchmark.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-strong); margin-bottom: 10px;">{{ page.body.benchmark.num }} · {{ page.chrome.toc[2].label }}</div>
        <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 12px; color: var(--color-accent);">{{ page.body.benchmark.heading }}</h2>
        <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 28px; font-weight: 300; max-width: 72ch;">{{ page.body.benchmark.lead }}</p>

        <div data-r="grid2" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 32px; margin-bottom: 36px;">
          <div>
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong); margin-bottom: 10px;">{{ page.body.benchmark.modelLabel }}</div>
            <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300;">{{ page.body.benchmark.modelLead }}</p>
          </div>
          <div style="display: flex; flex-direction: column; gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule);">
{% for m in page.body.benchmark.model %}
            <div style="background: var(--color-surface); padding: 16px 18px; display: flex; flex-direction: column; gap: 6px;">
              <div style="font-size: var(--text-ui); color: var(--color-ink);">{{ m.t }}</div>
              <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 0;">{{ m.d }}</p>
            </div>
{% endfor %}
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 32px;">
          <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.benchmark.evidenceLabel }}</div>
          <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300; max-width: 72ch;">{{ page.body.benchmark.evidenceLead }}</p>
          <div style="font-size: var(--text-ui); color: var(--color-ink); margin-top: 4px;">{{ page.body.benchmark.tableLabel }}</div>
          <div style="border: 1px solid var(--color-rule); overflow-x: auto;">
            <div style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); border-bottom: 1px solid var(--color-rule-strong); min-width: 520px;">
              <div style="font-size: var(--text-ui); padding: 12px 20px; color: var(--color-muted);">{{ page.body.benchmark.colA }}</div>
              <div style="font-size: var(--text-ui); padding: 12px 20px; color: var(--color-accent-strong);">{{ page.body.benchmark.colB }}</div>
            </div>
{% for row in page.body.benchmark.rows %}
            <div style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); border-bottom: 1px solid var(--color-rule); min-width: 520px;{% if loop.last %} border-bottom: 0;{% endif %}">
              <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-body); margin: 0; padding: 14px 20px;">{{ row.finding }}</p>
              <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-ink); margin: 0; padding: 14px 20px;">{{ row.implication }}</p>
            </div>
{% endfor %}
          </div>
          <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 4px 0 0; max-width: 78ch;">{{ page.body.benchmark.source }}</p>
        </div>

        <div style="display: flex; flex-direction: column; gap: 14px;">
          <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.benchmark.problemsLabel }}</div>
          <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-ink); margin: 0; max-width: 76ch; font-weight: 300;">{{ page.body.benchmark.problemsLead }}</p>
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1px; background: var(--color-rule); border: 1px solid var(--color-rule);">
{% for p in page.body.benchmark.problems %}
            <div style="background: var(--color-surface); padding: 22px; display: flex; flex-direction: column; gap: 10px;">
              <span style="align-self: flex-start; border: 1px solid var(--color-accent); color: var(--color-accent-strong); padding: 4px 10px; border-radius: 999px; font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;">{{ p.k }}</span>
              <h3 style="margin: 0; color: var(--color-ink); font-size: 15px; max-width: 24ch;">{{ p.t }}</h3>
              <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-body); margin: 0;">{{ p.d }}</p>
            </div>
{% endfor %}
          </div>
          <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 4px 0 0; max-width: 76ch;">{{ page.body.benchmark.problemsNote }}</p>
        </div>
      </div>

      <div id="{{ page.body.product.id }}" data-sec="{{ page.body.product.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-strong); margin-bottom: 10px;">{{ page.body.product.num }} · {{ page.chrome.toc[3].label }}</div>
        <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 12px; color: var(--color-accent);">{{ page.body.product.heading }}</h2>
        <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 30px; font-weight: 300; max-width: 72ch;">{{ page.body.product.lead }}</p>

        <div style="padding-bottom: 32px; border-bottom: 1px solid var(--color-rule); margin-bottom: 32px;">
          <div data-r="grid2" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1.5fr); gap: 32px; align-items: start;">
            <div style="display: flex; flex-direction: column; gap: 12px;">
              <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.product.c1.label }}</div>
              <span style="align-self: flex-start; border: 1px solid var(--color-accent); color: var(--color-accent-strong); padding: 4px 10px; border-radius: 999px; font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;">{{ page.body.product.c1.ref }}</span>
              <h3 style="margin: 0; color: var(--color-ink); font-size: 15px;">{{ page.body.product.c1.title }}</h3>
              <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 56ch;">{{ page.body.product.c1.p1 }}</p>
              <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 56ch;">{{ page.body.product.c1.p2 }}</p>
              <div style="border-left: 2px solid var(--color-accent); padding-left: 16px;">
                <div style="font-size: var(--text-ui); color: var(--color-accent-strong); margin-bottom: 4px;">{{ page.body.product.costLabel }}</div>
                <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 54ch;">{{ page.body.product.c1.cost }}</p>
              </div>
            </div>
            <div style="border: 1px solid var(--color-accent); padding: 20px; display: flex; flex-direction: column; gap: 12px;">
              <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.product.c1.modelLabel }}</div>
              <div style="display: flex; flex-direction: column; gap: 8px;">
{% for e in page.body.product.c1.entities %}
                <div style="border: 1px solid var(--color-chip-border); padding: 10px 12px;">
                  <div style="font-size: var(--text-ui); color: var(--color-ink);">{{ e.t }}</div>
                  <div style="font-size: var(--text-note); color: var(--color-muted);">{{ e.d }}</div>
                </div>
{% if not loop.last %}
                <div style="font-size: var(--text-note); color: var(--color-muted); text-align: center;">{{ page.body.product.c1.rels[loop.index0] }}</div>
{% endif %}
{% endfor %}
              </div>
              <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-body); margin: 0;">{{ page.body.product.c1.note2 }}</p>
              <p style="font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 0;">{{ page.body.product.c1.note }}</p>
            </div>
          </div>
        </div>

        <div style="padding-bottom: 32px; border-bottom: 1px solid var(--color-rule); margin-bottom: 32px;">
          <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 20px;">
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.product.c2.label }}</div>
            <span style="align-self: flex-start; border: 1px solid var(--color-accent); color: var(--color-accent-strong); padding: 4px 10px; border-radius: 999px; font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;">{{ page.body.product.c2.ref }}</span>
            <h3 style="margin: 0; color: var(--color-ink); font-size: 15px; max-width: 44ch;">{{ page.body.product.c2.title }}</h3>
            <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300; max-width: 74ch;">{{ page.body.product.c2.p1 }}</p>
            <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300; max-width: 74ch;">{{ page.body.product.c2.p2 }}</p>
          </div>
          <div style="margin-bottom: 20px;">
            <div style="font-size: var(--text-ui); color: var(--color-muted); margin-bottom: 6px;">{{ page.body.product.c2.routesLabel }}</div>
{% for r in page.body.product.c2.routes %}
            <div style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 24px; padding: 16px 0;{% if not loop.last %} border-bottom: 1px solid var(--color-rule);{% endif %} align-items: start;">
              <div style="display: flex; flex-direction: column; gap: 6px;">
                <div style="color: var(--color-ink); font-size: 14px; font-weight: 600;">{{ r.t }}</div>
                <div style="font-size: var(--text-ui); color: var(--color-muted);">{{ r.c }}</div>
                <span style="align-self: flex-start; margin-top: 4px; border: 1px solid var(--color-chip-border); color: var(--color-accent-strong); padding: 4px 9px; border-radius: 999px; font-size: var(--text-legal);">{{ r.owner }}</span>
              </div>
              <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 62ch;">{{ r.d }}</p>
            </div>
{% endfor %}
          </div>
          <div style="border: 1px solid var(--color-accent); padding: 20px; display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px;">
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.product.c2.safety.label }}</div>
            <h3 style="margin: 0; color: var(--color-ink); font-size: 15px; max-width: 38ch;">{{ page.body.product.c2.safety.title }}</h3>
            <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300; max-width: 74ch;">{{ page.body.product.c2.safety.d }}</p>
          </div>
          <div style="border: 1px solid var(--color-rule-strong); padding: 20px; display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px;">
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.product.c2.actions.label }}</div>
            <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300; max-width: 74ch;">{{ page.body.product.c2.actions.d }}</p>
          </div>
          <div style="border-left: 2px solid var(--color-accent); padding-left: 16px;">
            <div style="font-size: var(--text-ui); color: var(--color-accent-strong); margin-bottom: 4px;">{{ page.body.product.costLabel }}</div>
            <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 72ch;">{{ page.body.product.c2.cost }}</p>
          </div>
        </div>

        <div data-r="grid2" style="display: grid; grid-template-columns: minmax(0,1fr) minmax(0,2fr); gap: 32px;">
          <div>
            <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong); margin-bottom: 10px;">{{ page.body.product.c3.label }}</div>
            <span style="align-self: flex-start; border: 1px solid var(--color-accent); color: var(--color-accent-strong); padding: 4px 10px; border-radius: 999px; font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;">{{ page.body.product.c3.ref }}</span>
            <h3 style="margin: 10px 0 0; color: var(--color-ink); font-size: 15px;">{{ page.body.product.c3.title }}</h3>
          </div>
          <div style="display: flex; flex-direction: column; gap: 14px;">
            <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 68ch;">{{ page.body.product.c3.p1 }}</p>
            <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 68ch;">{{ page.body.product.c3.p2 }}</p>
            <div style="border-left: 2px solid var(--color-accent); padding-left: 16px;">
              <div style="font-size: var(--text-ui); color: var(--color-accent-strong); margin-bottom: 4px;">{{ page.body.product.costLabel }}</div>
              <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 66ch;">{{ page.body.product.c3.cost }}</p>
            </div>
          </div>
        </div>
      </div>

      <div style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
        <div style="margin-bottom: 8px;">
          <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-accent-strong); margin-bottom: 10px;">{{ page.body.ux.num }} · {{ page.body.ux.heading }}</div>
          <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300; max-width: 72ch;">{{ page.body.ux.lead }}</p>

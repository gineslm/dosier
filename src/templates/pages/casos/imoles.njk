            <p style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0; font-weight: 300; max-width: 70ch;">{{ page.body.ux.decisions.lead }}</p>
          </div>

{% for d in page.body.ux.decisions.items %}
          <div style="padding-bottom: 32px; border-bottom: 1px solid var(--color-rule); margin-bottom: 32px;">
            <div data-r="grid2" style="display: grid; grid-template-columns: minmax(280px,464px) minmax(0,1fr); gap: 32px; align-items: start;">
              <div data-r="pair" style="display: flex; gap: 16px; align-items: flex-start; flex-wrap: wrap;">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                  <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-muted);">{{ page.body.ux.decisions.beforeLabel }}</div>
                  <img src="{{ assetsPath }}assets/img/casos/imoles/{{ d.beforeImg }}" alt="{{ d.beforeAlt }}" style="width: 180px; height: 330px; object-fit: cover; object-position: top; border: 1px solid var(--color-rule); display: block;">
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                  <div style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--color-accent-strong);">{{ page.body.ux.decisions.afterLabel }}</div>
                  <img src="{{ assetsPath }}assets/img/casos/imoles/{{ d.afterImg }}" alt="{{ d.afterAlt }}" style="width: 180px; height: auto; border: 1px solid var(--color-rule); display: block;">

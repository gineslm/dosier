                  <div style="flex: 1; min-width: 0;"><div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 8px; align-items: baseline;"><span style="font-size: 19px; font-weight: 500; color: #1f2d3d;">BKCOT342117VLC</span><span style="font-size: 16px; color: #5a6878;">09/02/2022</span></div><div style="font-size: 17px; color: #5a6878; margin: 4px 0 6px;">ESVLC → TNTUN</div><span style="font-size: 16px; font-weight: 600; color: #5a6878;">CLOSED</span></div>
                  <span style="width: 48px; height: 48px; flex-shrink: 0; border-radius: 4px; background: #538cff; color: #fff; display: flex; align-items: center; justify-content: center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></span>
                </div>
                <div style="box-shadow: inset 0 0 0 1px #a9e0dc; padding: 12px 8px 12px 14px; display: flex; align-items: center; gap: 10px; border-radius: 4px; background-color: #C9EFED;">
                  <div style="flex: 1; min-width: 0;"><div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 2px 8px; align-items: baseline;"><span style="font-size: 19px; font-weight: 500; color: #1f2d3d;">BKCOT342124VLC</span><span style="font-size: 16px; color: #5a6878;">03/01/2022</span></div><div style="font-size: 17px; color: #5a6878; margin: 4px 0 6px;">ESVLC → TNSUS</div><span style="font-size: 16px; font-weight: 600; color: #5a6878;">CLOSED</span></div>
                  <span style="width: 48px; height: 48px; flex-shrink: 0; border-radius: 4px; background: #538cff; color: #fff; display: flex; align-items: center; justify-content: center;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </div>
  <p style="font-size: var(--text-note); line-height: var(--case-lh-note); color: var(--color-muted); margin: 12px 0 0; max-width: 619px;">{{ page.body.portal.scrollHint }}</p>
</div>

<div id="{{ page.body.projects.id }}" data-sec="{{ page.body.projects.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
  <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.projects.heading }}</h2>
  <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 24px; font-weight: 300; max-width: 619px; text-wrap: pretty;">{{ page.body.projects.text }}</p>
  <div style="display: flex; flex-direction: column; gap: 40px;">
{% for p in page.body.projects.items %}
    <div style="display: flex; flex-direction: column; gap: 14px;">
      <div style="display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px;">
        <span style="font-size: var(--text-h3-sm); font-weight: 300; color: var(--color-ink);">{{ p.title }}</span>
        <span style="font-size: var(--text-ui); color: var(--color-muted);">{{ p.year }}</span>
      </div>
      <span class="rwd-badge" style="background: var(--color-accent-soft); color: var(--color-accent-strong);">{{ p.pattern }}</span>
      <div role="button" tabindex="0" class="rwd-js-lightbox" data-lb-src="{{ assetsPath }}assets/img/casos/web-responsive/{{ p.img }}" style="display: grid; grid-template-columns: minmax(0,1fr) 150px; gap: 16px; align-items: end; cursor: zoom-in;">
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <div class="rwd-crop" style="aspect-ratio: {{ p.cropDesktop.w }} / {{ p.cropDesktop.h }};"><img src="{{ assetsPath }}assets/img/casos/web-responsive/{{ p.img }}" alt="" style="width: calc(1920 / {{ p.cropDesktop.w }} * 100%); left: calc({{ -p.cropDesktop.x }} / {{ p.cropDesktop.w }} * 100%); top: calc({{ -p.cropDesktop.y }} / {{ p.cropDesktop.h }} * 100%);"></div>
          <span style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted);">{{ page.body.projects.desktopLabel }}</span>
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <div class="rwd-crop" style="aspect-ratio: {{ p.cropMobile.w }} / {{ p.cropMobile.h }};"><img src="{{ assetsPath }}assets/img/casos/web-responsive/{{ p.img }}" alt="" style="width: calc(1920 / {{ p.cropMobile.w }} * 100%); left: calc({{ -p.cropMobile.x }} / {{ p.cropMobile.w }} * 100%); top: calc({{ -p.cropMobile.y }} / {{ p.cropMobile.h }} * 100%);"></div>
          <span style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted);">{{ page.body.projects.mobileLabel }}</span>
        </div>
      </div>
      <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; max-width: 75ch;">{{ p.text }}</p>
      <a href="#" class="rwd-js-lightbox" data-lb-src="{{ assetsPath }}assets/img/casos/web-responsive/{{ p.img }}" style="font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; color: var(--color-accent-strong); text-transform: uppercase; letter-spacing: 0.04em;">{{ page.body.projects.seeFull }}</a>
    </div>
{% endfor %}
  </div>
</div>

<div id="{{ page.body.experience.id }}" data-sec="{{ page.body.experience.id }}" style="max-width: 619px; padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
  <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.experience.heading }}</h2>
  <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 20px; font-weight: 300; max-width: 75ch; text-wrap: pretty;">{{ page.body.experience.text }}</p>
  <div style="display: flex; flex-direction: column; gap: 20px;">
{% for ex in page.body.experience.items %}
    <div style="display: flex; flex-direction: column; gap: 6px; padding-left: 16px; border-left: 1px solid var(--color-chip-border);">
      <span style="font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-accent-strong);">{{ ex.name }}</span>
      <span style="font-size: var(--text-h3-sm); font-weight: 300; color: var(--color-ink); line-height: 1.3;">{{ ex.tech }}</span>
      <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); margin: 0; text-wrap: pretty;">{{ ex.desc }}</p>
    </div>
{% endfor %}
  </div>
</div>

<div style="max-width: 619px;">
  <p data-r="closing" style="font-size: 26px; line-height: 1.4; font-weight: 300; color: var(--color-ink); margin: 0; max-width: 34ch; text-wrap: pretty;">{{ page.body.closing }}</p>
</div>

<div class="lb-overlay" id="rwdLightbox">
  <button type="button" class="lb-close" id="rwdLightboxClose">{{ page.body.portal.close }} ✕</button>
  <img id="rwdLightboxImg" src="" alt="">
</div>

<script>
(function () {
  // Componente toolbar (fuente: handoff/toolbar/toolbar-responsive.html) —
  // se porta tal cual, solo se sustituye el objeto T por el contenido ya
  // resuelto en el idioma de la página (viene de content/casos/web-responsive).
  var t = {
    links: {{ page.body.component.links | json | safe }},
    v1: {{ page.body.component.desktopView.title | json | safe }}, v1n: {{ page.body.component.desktopView.note | json | safe }},
    v2: {{ page.body.component.tabletView.title | json | safe }}, v2n: {{ page.body.component.tabletView.note | json | safe }},
    v3: {{ page.body.component.mobileView.title | json | safe }}, v3n: {{ page.body.component.mobileView.note | json | safe }},
    pDesk: {{ page.body.component.modeDesktop | json | safe }}, pTab: {{ page.body.component.modeTablet | json | safe }}, pMob: {{ page.body.component.modeMobile | json | safe }}
  };
  var BP_DESK = 620, BP_TAB = 320;
  var PRESETS = { d: { w: 0, open: null }, t: { w: 470, open: 'gN' }, m: { w: 272, open: 'gL' } };
  var BADGES = [2, 5, 6, 8];
  var CHANNELS = ['R', 'Q', 'M', 'U', 'F', 'L', 'G', 'Z'], CH_BADGES = [1, 3, 4, 6];

  var $ = function (s) { return document.querySelector(s); };
  var $$ = function (s) { return Array.prototype.slice.call(document.querySelectorAll(s)); };
  var stage = $('#tbStage'), tb = $('#tbWidget');
  var state = { w: 0, open: null, forceDesk: true, search: false };

  if (tb) {
    $('#tbDeskLinks').innerHTML = '<span class="i-sq"></span>'.repeat(8);
    $('#tbDeskNtf').innerHTML = Array.from({ length: 9 }, function (_, i) {
      return '<span class="i-bell' + (BADGES.indexOf(i) > -1 ? ' has-badge' : '') + '"></span>';
    }).join('');
    $('#tbPopNtf').innerHTML = CHANNELS.map(function (c, i) {
      return '<div class="tb__pop-row"><span class="ch">' + c + '</span><span class="i-bell' + (CH_BADGES.indexOf(i) > -1 ? ' has-badge' : '') + '"></span><span class="n">' + (CH_BADGES.indexOf(i) > -1 ? '44' : '') + '</span></div>';
    }).join('');
    $('#tbPopLinks').innerHTML = t.links.map(function (l) {
      return '<div class="tb__pop-row"><span class="i-sq"></span><span class="lbl">' + l + '</span></div>';
    }).join('');

    function mode() {
      var w = state.w;
      var fd = state.forceDesk && (!w || w < BP_DESK);
      return { m: fd || !w || w >= BP_DESK ? 'd' : w >= BP_TAB ? 't' : 'm', fd: fd };
    }
    function render() {
      var mm = mode(), m = mm.m, fd = mm.fd;
      tb.setAttribute('data-mode', m);
      if (fd && state.w) { tb.style.width = BP_DESK + 'px'; tb.style.zoom = String(state.w / BP_DESK); }
      else { tb.style.width = ''; tb.style.zoom = ''; }
      var open = m === 'd' ? null : state.open;
      $$('.tb__gicon').forEach(function (b) { b.setAttribute('aria-expanded', String(b.getAttribute('data-group') === open)); });
      $$('[data-pop]').forEach(function (p) { p.classList.toggle('is-open', p.getAttribute('data-pop') === open); });
      var so = m === 'd' && state.search;
      $('#tbSearchBtn').classList.toggle('is-open', so);
      $('#tbSearchBar').classList.toggle('is-open', so);
      $('#tbBadge').textContent = (m === 'd' ? t.pDesk : m === 't' ? t.pTab : t.pMob) + ' · ' + (state.w + 28) + ' px';
      $('#tbModeTitle').textContent = t['v' + (m === 'd' ? 1 : m === 't' ? 2 : 3)];
      $('#tbModeNote').textContent = t['v' + (m === 'd' ? 1 : m === 't' ? 2 : 3) + 'n'];
      $$('[data-preset]').forEach(function (a) { a.classList.toggle('lang-switch__option--active', a.getAttribute('data-preset') === m); });
    }

    if (window.ResizeObserver) {
      new ResizeObserver(function (es) {
        var w = Math.round(es[0].contentRect.width);
        if (w !== state.w) { state.w = w; render(); }
      }).observe(stage);
    }

    stage.addEventListener('mousedown', function (e) {
      var r = stage.getBoundingClientRect();
      if (e.clientX > r.right - 24 && e.clientY > r.bottom - 24 && state.forceDesk) { state.forceDesk = false; render(); }
    });

    $$('[data-preset]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        e.preventDefault();
        var p = PRESETS[a.getAttribute('data-preset')];
        stage.style.width = p.w ? p.w + 'px' : '100%';
        state.open = p.open; state.forceDesk = !p.w; state.search = false;
        render();
      });
    });

    $('#tbSearchBtn').addEventListener('click', function () { state.search = !state.search; render(); });
    $$('.tb__gicon').forEach(function (b) {
      b.addEventListener('click', function () {
        var g = b.getAttribute('data-group');
        state.open = state.open === g ? null : g;
        render();
      });
    });
    $$('[data-close]').forEach(function (b) { b.addEventListener('click', function () { state.open = null; render(); }); });

    render();
  }

  // Lightbox de imágenes (portal + proyectos)
  var lb = document.getElementById('rwdLightbox');
  var lbImg = document.getElementById('rwdLightboxImg');
  function openLb(src) { lbImg.src = src; lb.classList.add('is-open'); }
  function closeLb() { lb.classList.remove('is-open'); lbImg.src = ''; }
  Array.prototype.forEach.call(document.querySelectorAll('.rwd-js-lightbox'), function (el) {
    el.addEventListener('click', function (e) {
      e.preventDefault();
      openLb(el.getAttribute('data-lb-src'));
    });
  });
  document.getElementById('rwdLightboxClose').addEventListener('click', closeLb);
  lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
  window.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeLb(); });
})();
</script>
{% endblock %}

{% extends "layouts/case-study.njk" %}
{% block body %}
<style>
  /* Estilos propios de esta página (widget de componente, portal y galería).
     Van aquí, no en case.css, porque son específicos de este caso — case.css
     documenta que el maquetado compartido va inline y solo lo realmente
     transversal (tema, índice, responsive) vive en la hoja compartida. */
  /* ---------- Componente toolbar (fuente: handoff/toolbar/toolbar-responsive.html) ---------- */
  .tb-demo { display: flex; flex-direction: column; gap: 12px; }
  .tb-demo__controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; }
  .tb-demo__controls .lang-switch__option { height: 26px; padding: 0 12px; cursor: pointer; }
  .tb-demo__hint { font-size: var(--text-note); color: var(--color-muted); }
  .tb-stage { resize: horizontal; overflow: hidden; width: 100%; max-width: 100%; min-width: 240px; height: 400px; border: 1px dashed var(--color-chip-border); border-radius: 6px; padding: 14px; box-sizing: border-box; position: relative; background-image: repeating-linear-gradient(45deg,rgba(255,255,255,0.07) 0 1px,transparent 1px 8px,rgba(0,0,0,0.28) 8px 9px,transparent 9px 16px); }
  .tb-stage__badge { position: absolute; right: 10px; bottom: 8px; font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-strong); }
  .tb-mode { display: flex; flex-direction: column; gap: 6px; max-width: 619px; }
  .tb-mode__chip { align-self: flex-start; background: var(--color-accent); color: var(--color-on-accent); font-family: var(--font-condensed); font-size: var(--text-legal); padding: 4px 10px; border-radius: 8px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .tb-mode__note { font-size: var(--text-note); line-height: 1.5; color: var(--color-muted); margin: 0; }

  .tb { --tb-line: #e2e2e2; --tb-ink: #4a4a4a; --tb-icon: #6b6b6b; --tb-row2: 28px; --tb-lift: 8px; display: grid; grid-template-columns: minmax(44px,150px) max-content minmax(0,1fr) max-content; transform-origin: 0 0; }
  .tb button { font: inherit; }
  .tb__logo { grid-column: 1 / -1; height: 12px; background: #fff; border: 1px solid var(--tb-line); border-bottom: 0; display: flex; gap: 3px; padding-left: 52px; }
  .tb__logo span { width: 22px; height: 5px; }
  .tb__logo span:nth-child(1) { background: #6b6b6b; } .tb__logo span:nth-child(2) { background: #9a9a9a; }
  .tb__logo span:nth-child(3) { background: #b8b8b8; } .tb__logo span:nth-child(4) { background: #cfcfcf; }
  .tb__row { grid-column: 1 / -1; position: relative; display: grid; grid-template-columns: subgrid; height: var(--tb-row2); background: #fff; border-bottom: 1px solid var(--tb-line); box-sizing: border-box; }
  .tb__cell { box-sizing: border-box; min-height: 0; border-left: 1px solid var(--tb-line); display: flex; align-items: center; }
  .tb__a { padding-bottom: var(--tb-lift); }
  .tb__a .tb__ico { width: 44px; }
  .tb__b { align-items: stretch; }
  .tb__b > .tb__pop--links, .tb__b > .tb__pop--ntf { margin-left: 44px; }
  .tb__c { border-right: 1px solid var(--tb-line); justify-content: flex-end; padding-bottom: var(--tb-lift); }
  .tb__ico { display: flex; align-items: center; justify-content: center; }
  .i-sq { width: 14px; height: 14px; border: 1px solid var(--tb-icon); border-radius: 2px; box-sizing: border-box; flex-shrink: 0; }
  .i-bell { position: relative; width: 14px; height: 14px; border: 1px solid var(--tb-icon); border-radius: 7px 7px 2px 2px; box-sizing: border-box; flex-shrink: 0; }
  .i-bell.has-badge::after { content: ""; position: absolute; right: -5px; top: -5px; width: 7px; height: 7px; border-radius: 50%; background: var(--color-accent); }
  .tb__groups { display: flex; align-items: stretch; position: relative; }
  .tb__grp { display: flex; align-items: center; gap: 8px; padding: 0 10px var(--tb-lift); border-left: 1px solid var(--tb-line); }
  .tb__grp:first-child { border-left: 0; }
  .tb__search-btn { width: 35px; padding: 0 0 var(--tb-lift); border: 0; background: transparent; cursor: pointer; justify-content: center; }
  .tb__search-btn.is-open { background: #f2f2f1; }
  .tb__search-btn .i-close { display: none; }
  .tb__search-btn.is-open .i-lupa { display: none; }
  .tb__search-btn.is-open .i-close { display: block; }
  .tb__search { position: absolute; top: -2px; bottom: 0; left: 35px; right: 0; z-index: 2; background: #fff; border-left: 1px solid var(--tb-line); display: none; align-items: center; gap: 6px; padding: 2px 6px var(--tb-lift) 8px; box-sizing: border-box; }
  .tb__search.is-open { display: flex; }
  .tb__input { flex: 1; min-width: 0; height: 18px; font-size: 10px; border: 1px solid #cfcfcf; border-radius: 2px; background: #fff; padding: 0 6px; color: #1c1c1c; font-family: var(--font-body); box-sizing: border-box; outline: none; }
  .tb__go { width: 22px; height: 18px; flex-shrink: 0; border: 0; border-radius: 2px; background: var(--tb-ink); display: flex; align-items: center; justify-content: center; padding: 0; cursor: pointer; }
  .tb__compact { display: none; align-items: stretch; margin-left: -1px; }
  .tb__gicon { width: 44px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; cursor: pointer; padding: 0 0 var(--tb-lift); box-sizing: border-box; border: 0; border-left: 1px solid var(--tb-line); background: transparent; }
  .tb__gicon[aria-expanded="true"] { background: var(--color-accent); }
  .tb__gicon > span { position: relative; display: flex; }
  .tb__gicon > span::after { content: "▾"; position: absolute; right: -9px; bottom: -6px; font-size: 8px; color: var(--tb-icon); }
  .tb__pop { position: absolute; top: 100%; margin-top: 1px; background: #fff; border: 1px solid var(--tb-line); box-shadow: 0 12px 24px -8px rgba(0,0,0,0.5); z-index: 3; display: none; flex-direction: column; }
  .tb__pop.is-open { display: flex; }
  .tb__pop--search { left: 0; right: 0; width: auto; flex-direction: row; align-items: center; gap: 6px; padding: 6px; box-sizing: border-box; }
  .tb__pop--search.is-open { display: flex; }
  .tb__pop--search .tb__input { height: 28px; font-size: 11px; padding: 0 8px; }
  .tb__pop--search .tb__go { width: 28px; height: 28px; }
  .tb__pop-close { width: 28px; height: 28px; flex-shrink: 0; border: 0; background: transparent; display: flex; align-items: center; justify-content: center; padding: 0; cursor: pointer; }
  .tb__pop--links { left: 0; min-width: 170px; }
  .tb__pop--ntf { left: 88px; min-width: 92px; }
  .tb__pop-row { height: 36px; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-top: 1px solid #f0f0f0; }
  .tb__pop-row:first-child { border-top: 0; }
  .tb__pop-row span.lbl { font-size: 11px; color: #1c1c1c; white-space: nowrap; }
  .tb__pop--ntf .tb__pop-row { justify-content: space-between; padding: 0 10px; }
  .tb__pop--ntf .ch { font-size: 10px; color: var(--tb-icon); width: 10px; }
  .tb__pop--ntf .n { font-size: 9px; color: var(--tb-icon); min-width: 14px; text-align: right; }
  .tb__user-txt { display: flex; flex-direction: column; justify-content: center; align-items: flex-end; font-size: 9px; color: var(--tb-icon); line-height: 1.3; padding: 0 6px 0 10px; white-space: nowrap; }
  .tb__user-txt span:last-child { text-transform: uppercase; }
  .tb__user-ico { width: 44px; height: calc(100% + var(--tb-lift)); margin-bottom: calc(var(--tb-lift) * -1); padding-bottom: var(--tb-lift); box-sizing: border-box; border-left: 1px solid var(--tb-line); }
  .tb__ann { padding-top: 8px; min-width: 0; }
  .tb__ann::before { content: ""; display: block; height: 6px; border: 1px solid var(--color-chip-border); border-top: 0; margin: 0 2px; }
  .tb__ann span { display: block; margin-top: 4px; font-size: 10px; line-height: 1.35; color: var(--color-muted); }
  .tb__ann b { font-family: var(--font-condensed); font-weight: 700; color: var(--color-accent-strong); margin-right: 4px; }
  .tb__ann--a { grid-column: 1; } .tb__ann--b { grid-column: 2 / 4; } .tb__ann--c { grid-column: 4; }
  .tb[data-mode="t"] .tb__groups, .tb[data-mode="m"] .tb__groups { display: none; }
  .tb[data-mode="t"] .tb__compact, .tb[data-mode="m"] .tb__compact { display: flex; }
  .tb[data-mode="m"] .tb__user-txt { display: none; }
  .tb[data-mode="d"] .tb__pop { display: none !important; }

  .lb-overlay { position: fixed; inset: 0; z-index: 50; background: rgba(14,12,16,0.92); display: none; justify-content: center; overflow-y: auto; padding: 72px 24px 48px; box-sizing: border-box; }
  .lb-overlay.is-open { display: flex; }
  .lb-close { position: fixed; top: 16px; right: 20px; height: 36px; padding: 0 14px; border-radius: 999px; border: 1px solid var(--color-chip-border); background: var(--color-surface); color: var(--color-ink); font-family: var(--font-condensed); font-size: var(--text-legal); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; cursor: pointer; }
  .lb-overlay img { width: 100%; max-width: 1100px; height: auto; align-self: flex-start; }

  .rwd-crop { position: relative; overflow: hidden; border-radius: 6px; border: 1px solid var(--color-chip-border); background: #111; cursor: zoom-in; }
  .rwd-crop img { position: absolute; max-width: none; height: auto; display: block; }

  .rwd-phone-scroll { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.45) transparent; }
  .rwd-phone-scroll::-webkit-scrollbar { width: 4px; }
  .rwd-phone-scroll::-webkit-scrollbar-track { background: transparent; }
  .rwd-phone-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.45); border-radius: 4px; }
</style>

<div id="cover" data-sec="cover" style="padding: 8px 0 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
  <h1 data-r="h1-app" style="font-weight: var(--weight-thin); font-size: 72px; line-height: var(--text-name-lh); margin: 0 0 14px; color: var(--color-ink);">{{ page.body.hero.h1 }}</h1>
  <h1 data-r="h1-lead" style="font-weight: var(--weight-thin); font-size: var(--text-name); line-height: var(--text-name-lh); margin: 0 0 14px; color: var(--color-ink); max-width: 20ch; text-wrap: pretty;">{{ page.body.hero.lead }}</h1>
  <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-muted); margin: 8px 0 0;">{{ page.body.hero.meta }}</p>
</div>

<div style="max-width: 619px; padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
  <div style="border: 1px solid var(--color-chip-border); border-left: 4px solid var(--color-accent); background: var(--color-accent-soft); padding: 20px;">
    <p style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.08em; color: var(--color-accent-strong); margin: 0 0 8px; text-transform: uppercase;">{{ page.body.hero.archKicker }}</p>
    <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); font-style: italic; color: var(--color-ink); margin: 0; font-weight: 300;">{{ page.body.hero.archText }}</p>
  </div>
  <p style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-muted); margin: 10px 0 0; max-width: 75ch;">{{ page.body.hero.archNote }}</p>
</div>

<div id="{{ page.body.criteria.id }}" data-sec="{{ page.body.criteria.id }}" style="max-width: 619px; padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
  <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.criteria.heading }}</h2>
  <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 20px; font-weight: 300; max-width: 75ch; text-wrap: pretty;">{{ page.body.criteria.text }}</p>
  <div style="display: flex; flex-direction: column; border-top: 1px solid var(--color-rule);">
{% for b in page.body.criteria.breakpoints %}
    <div style="display: grid; grid-template-columns: 72px minmax(0,1fr); gap: 16px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--color-rule);">
      <span style="font-family: var(--font-condensed); font-size: 17px; font-weight: 700; color: var(--color-accent-strong);">{{ b.w }}</span>
      <span style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body);"><b style="color: var(--color-ink); font-weight: 500;">{{ b.name }}</b> · {{ b.desc }}</span>
    </div>
{% endfor %}
  </div>
  <h3 style="font-family: var(--font-condensed); font-weight: 700; font-size: var(--text-legal); letter-spacing: 0.08em; text-transform: uppercase; margin: 32px 0 10px; color: var(--color-accent-strong);">{{ page.body.criteria.methodsHeading }}</h3>
  <div style="display: flex; flex-direction: column; border-top: 1px solid var(--color-rule);">
{% for m in page.body.criteria.methods %}
    <div style="display: grid; grid-template-columns: minmax(0,170px) minmax(0,1fr); gap: 16px; align-items: baseline; padding: 12px 0; border-bottom: 1px solid var(--color-rule);">
      <span style="font-size: var(--text-ui); font-weight: 500; color: var(--color-ink);">{{ m.name }}</span>
      <span style="font-size: var(--text-ui); line-height: 1.6; color: var(--color-body); text-wrap: pretty;">{{ m.desc }}</span>
    </div>
{% endfor %}
  </div>
  <p style="font-size: var(--text-note); line-height: var(--case-lh-note); color: var(--color-muted); margin: 12px 0 0;">{{ page.body.criteria.methodsNote }}</p>
</div>

<div id="{{ page.body.component.id }}" data-sec="{{ page.body.component.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
  <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.component.heading }}</h2>
  <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 14px; font-weight: 300; max-width: 619px; text-wrap: pretty;">{{ page.body.component.text }}</p>
  <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 28px; font-weight: 300; max-width: 619px; text-wrap: pretty;">{{ page.body.component.anatomyText }}</p>

  <div class="tb-demo">
    <div class="tb-demo__controls">
      <div class="lang-switch" role="group" id="tbPresets">
        <a class="lang-switch__option lang-switch__option--active" href="#" data-preset="d">{{ page.body.component.modeDesktop }}</a>
        <a class="lang-switch__option" href="#" data-preset="t">{{ page.body.component.modeTablet }}</a>
        <a class="lang-switch__option" href="#" data-preset="m">{{ page.body.component.modeMobile }}</a>
      </div>
      <span class="tb-demo__hint">{{ page.body.component.dragHint }}</span>
    </div>

    <div class="tb-stage" id="tbStage">
      <span class="tb-stage__badge" id="tbBadge"></span>

      <div class="tb" id="tbWidget" data-mode="d">
        <div class="tb__logo" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

        <div class="tb__row">
          <div class="tb__cell tb__a">
            <div class="tb__ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a4a4a" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></div>
          </div>

          <div class="tb__cell tb__b">
            <div class="tb__groups">
              <button type="button" class="tb__grp tb__search-btn" id="tbSearchBtn" aria-label="{{ page.body.component.searchLabel }}">
                <svg class="i-lupa" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#4a4a4a" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path></svg>
                <svg class="i-close" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4a4a4a" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
              </button>
              <div class="tb__grp" id="tbDeskLinks"></div>
              <div class="tb__grp" id="tbDeskNtf"></div>
              <div class="tb__search" id="tbSearchBar">
                <input class="tb__input" type="text" placeholder="{{ page.body.component.searchPlaceholder }}">
                <button type="button" class="tb__go" aria-label="{{ page.body.component.searchLabel }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
              </div>
            </div>

            <div class="tb__compact">
              <button type="button" class="tb__gicon" data-group="gA" aria-expanded="false" aria-label="{{ page.body.component.searchLabel }}"><span><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#4a4a4a" stroke-width="2" stroke-linecap="round"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="M15.5 15.5L21 21"></path></svg></span></button>
              <button type="button" class="tb__gicon" data-group="gL" aria-expanded="false" aria-label="{{ page.body.component.blockB }}"><span><span class="i-sq"></span></span></button>
              <button type="button" class="tb__gicon" data-group="gN" aria-expanded="false" aria-label="{{ page.body.component.blockB }}"><span><span class="i-bell has-badge"></span></span></button>
            </div>

            <div class="tb__pop tb__pop--search" data-pop="gA">
              <button type="button" class="tb__pop-close" data-close="gA" aria-label="{{ page.body.portal.close }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4a4a4a" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
              <input class="tb__input" type="text" placeholder="{{ page.body.component.searchPlaceholder }}">
              <button type="button" class="tb__go" aria-label="{{ page.body.component.searchLabel }}"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="M13 6l6 6-6 6"></path></svg></button>
            </div>
            <div class="tb__pop tb__pop--links" data-pop="gL" id="tbPopLinks"></div>
            <div class="tb__pop tb__pop--ntf" data-pop="gN" id="tbPopNtf"></div>
          </div>

          <div class="tb__cell"></div>

          <div class="tb__cell tb__c">
            <div class="tb__user-txt"><span>{{ page.body.component.user }}</span><span>{{ page.body.component.branch }}</span></div>
            <div class="tb__ico tb__user-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#4a4a4a" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"></path></svg></div>
          </div>
        </div>

        <div class="tb__ann tb__ann--a"><span><b>A</b><i style="font-style: normal;">{{ page.body.component.blockA }}</i></span></div>
        <div class="tb__ann tb__ann--b"><span><b>B</b><i style="font-style: normal;">{{ page.body.component.blockB }}</i></span></div>
        <div class="tb__ann tb__ann--c"><span><b>C</b><i style="font-style: normal;">{{ page.body.component.blockC }}</i></span></div>
      </div>
    </div>

    <div class="tb-mode">
      <span class="tb-mode__chip" id="tbModeTitle"></span>
      <p class="tb-mode__note" id="tbModeNote"></p>
    </div>
  </div>

  <div style="max-width: 619px; border: 1px solid var(--color-chip-border); border-left: 4px solid var(--color-accent); background: var(--color-accent-soft); padding: 20px; margin-top: 24px;">
    <p style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.08em; color: #18DA95; margin: 0 0 8px; text-transform: uppercase;">{{ page.body.component.qaKicker }}</p>
    <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-ink); margin: 0; font-weight: 300;">{{ page.body.component.qaText }}</p>
  </div>
</div>

<div id="{{ page.body.portal.id }}" data-sec="{{ page.body.portal.id }}" style="padding-bottom: 40px; border-bottom: 1px solid var(--color-rule); scroll-margin-top: 90px;">
  <h2 style="font-family: var(--font-condensed); font-weight: 700; font-size: 17px; letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 14px; color: var(--color-accent);">{{ page.body.portal.heading }}</h2>
  <p data-r="body" style="font-size: var(--case-text-body); line-height: var(--case-lh-body); color: var(--color-body); margin: 0 0 8px; font-weight: 300; max-width: 619px; text-wrap: pretty;">{{ page.body.portal.text }}</p>
  <span class="rwd-badge" style="margin-bottom: 24px;">{{ page.body.portal.proposalTag }}</span>

  <div style="display: flex; flex-direction: column; gap: 32px; margin-top: 20px;">
{% for s in page.body.portal.screens %}
    <div style="display: flex; flex-direction: column; gap: 8px;">
      <div style="display: flex; align-items: center; gap: 10px;">
        <span class="rwd-badge" style="background: var(--color-accent-soft); color: var(--color-accent-strong);">{{ s.phase }}</span>
        <span style="font-family: var(--font-condensed); font-size: var(--text-kicker); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted);">{{ page.body.portal.desktopLabel }}</span>

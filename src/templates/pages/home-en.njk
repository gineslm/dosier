                            <div class="data-strip__item"><dt>Role</dt><dd>UX/UI</dd></div>
                            <div class="data-strip__item"><dt>Duration</dt><dd>1 month</dd></div>
                            <div class="data-strip__item"><dt>Sector</dt><dd>Maritime-port</dd></div>
                            <div class="data-strip__item"><dt>Output</dt><dd>Redesign in production</dd></div>
                        </dl>
                        <p class="project__text">

{% set stylesheetHref = assetsPath + 'styles.css' %}
{% include "partials/head.njk" %}

<body id="top">
    <a class="skip-link" href="#main">{{ page.chrome.skipLink }}</a>

    <div class="topbar" data-topbar>
        <div class="topbar__inner">
            <nav class="topbar__nav" aria-label="{{ page.chrome.topbarNavAriaLabel }}">
                <ul class="topbar__list" role="list">
{% for item in page.chrome.topbarNav %}
                    <li><a href="#{{ item.id }}"{% if item.current %} aria-current="true"{% endif %}>{{ item.label }}</a></li>
{% endfor %}
                </ul>
            </nav>
            <a class="topbar__top" href="#top" aria-label="{{ page.chrome.backToTopLabel }}">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M12 20V4"></path>
                    <path d="m5 11 7-7 7 7"></path>
                </svg>
            </a>
        </div>
    </div>

    <div class="shell">
        <div class="shell__rule" aria-hidden="true"></div>

        <aside class="sidebar">
{% include "partials/lang-switch.njk" %}
            <div class="sidebar__identity">
                <h1 class="sidebar__name">{% for line in common.site.nameLines %}{{ line }}{% if not loop.last %} <br>{% endif %}{% endfor %}</h1>
                <p class="sidebar__role">{% for line in common.site.roleLines %}{{ line }}{% if not loop.last %} <br>{% endif %}{% endfor %}</p>
            </div>

            <div class="sidebar__navwrap" data-navwrap>
                <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="{{ page.chrome.indexId }}" aria-label="{{ page.chrome.menuToggleLabel }}">
                    <span class="menu-toggle__bars" aria-hidden="true" focusable="false">
                        <span></span><span></span><span></span>
                    </span>
                </button>
                <nav class="nav-index" id="{{ page.chrome.indexId }}" aria-label="{{ page.chrome.indexAriaLabel }}">
                    <ul class="nav-index__list" role="list">
{% for item in page.chrome.indexNav %}
                        <li><a href="#{{ item.id }}"{% if item.current %} aria-current="true"{% endif %}>{{ item.label }}</a></li>
{% endfor %}
                    </ul>
                </nav>
            </div>

            <div class="sidebar__contact">
                <div class="sidebar__contact-kicker">{{ page.chrome.contactKicker }}</div>
                <div class="sidebar__contact-list">
                    <a href="mailto:{{ common.site.email }}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="4" width="20" height="16"></rect><path d="m2 6 10 7 10-7"></path></svg>
                        <span>{{ common.site.email }}</span>
                    </a>
                    <a href="tel:{{ common.site.phoneHref }}">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 3h4l2 5-2.5 1.5a12 12 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z"></path></svg>
                        <span>{{ common.site.phone }}</span>
                    </a>
                    <a href="{{ common.site.linkedinUrl }}" target="_blank" rel="noopener noreferrer">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4V9h4v1.5A5 5 0 0 1 16 8Z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                        <span class="icon-inline">{{ common.site.linkedinHandle }}
                            <svg class="external-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6"></path></svg>
                            <span class="visually-hidden">{{ page.chrome.opensInNewWindow }}</span>
                        </span>
                    </a>
                    <a href="{{ assetsPath }}assets/docs/{{ page.chrome.cvFile }}" target="_blank" rel="noopener noreferrer" download>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><path d="m7 10 5 5 5-5"></path><path d="M12 15V3"></path></svg>
                        <span class="icon-inline">{{ page.chrome.cvLabel }}
                            <svg class="external-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h6"></path></svg>
                            <span class="visually-hidden">{{ page.chrome.opensInNewWindow }}</span>
                        </span>
                    </a>
                </div>
            </div>
        </aside>

        <main id="main" tabindex="-1">
{% block body %}{% endblock %}

            <footer class="site-footer">
                <p class="site-footer__legal">© {{ common.site.copyrightYear }} {{ common.site.name }}</p>
            </footer>
        </main>
    </div>

    <script src="{{ assetsPath }}script.js"></script>
</body>

</html>
